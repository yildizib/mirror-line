MIRRORLINE_DOMAIN=mirrorline.example.com
POSTGRES_DB=mirrorline
POSTGRES_USER=mirrorline
POSTGRES_PASSWORD=replace-with-a-long-random-secret
# Base64url (unpadded) encoding of at least 32 random bytes; never reuse it across environments.
MIRRORLINE_PAIRING_CODE_HMAC_KEY=replace-with-a-32-byte-base64url-secret
FIREBASE_SERVICE_ACCOUNT_FILE=./secrets/firebase-service-account.json
